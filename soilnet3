# ──────────────────────────────────────────────
# 随机种子 / TimeTracker
# ──────────────────────────────────────────────
def set_seed(seed=42):
    random.seed(seed); np.random.seed(seed)
    torch.manual_seed(seed); torch.cuda.manual_seed(seed)
    torch.cuda.manual_seed_all(seed)
    torch.backends.cudnn.deterministic = True; torch.backends.cudnn.benchmark = False

class TimeTracker:
    def __init__(self):
        self.epoch_times, self.batch_times = [], []
        self.epoch_start = self.batch_start = None
    def start_epoch(self): self.epoch_start = time.time()
    def end_epoch(self):
        t = time.time() - self.epoch_start; self.epoch_times.append(t); return t
    def start_batch(self): self.batch_start = time.time()
    def end_batch(self):
        t = time.time() - self.batch_start; self.batch_times.append(t); return t
    def get_stats(self):
        return {
            'total_epoch_time': sum(self.epoch_times),
            'avg_epoch_time': float(np.mean(self.epoch_times)),
            'median_epoch_time': float(np.median(self.epoch_times)),
            'min_epoch_time': min(self.epoch_times), 'max_epoch_time': max(self.epoch_times),
            'avg_batch_time': float(np.mean(self.batch_times)) if self.batch_times else 0,
            'total_batch_time': sum(self.batch_times) if self.batch_times else 0,
        }

# 内存跟踪器
class MemoryTracker:
    """轻量级内存跟踪：每 epoch 记录一次峰值 GPU / CPU 内存，不影响训练速度"""
    def __init__(self, device):
        self.device = device
        self.history = []  # per-epoch
        self.peak_gpu_mb = 0.0
        self.peak_cpu_mb = 0.0

    def reset_epoch(self):
        """在 epoch 开始时调用，重置峰值计数器"""
        if self.device.type == 'cuda':
            torch.cuda.reset_peak_memory_stats(self.device)
            torch.cuda.synchronize()

    def record_epoch(self):
        """在 epoch 结束时调用，记录本 epoch 的峰值"""
        cpu_mb = psutil.Process().memory_info().rss / 1024 / 1024
        if self.device.type == 'cuda':
            torch.cuda.synchronize()
            gpu_mb = torch.cuda.max_memory_allocated(self.device) / 1024 / 1024
        else:
            gpu_mb = 0.0

        self.peak_gpu_mb = max(self.peak_gpu_mb, gpu_mb)
        self.peak_cpu_mb = max(self.peak_cpu_mb, cpu_mb)
        self.history.append({
            'gpu_peak_mb': round(gpu_mb, 1),
            'cpu_rss_mb':  round(cpu_mb, 1),
        })
        return gpu_mb, cpu_mb

    def get_stats(self):
        if not self.history:
            return {}
        gpu_peaks = [h['gpu_peak_mb'] for h in self.history]
        cpu_peaks = [h['cpu_rss_mb'] for h in self.history]
        return {
            'peak_gpu_mb': round(self.peak_gpu_mb, 1),
            'peak_cpu_mb': round(self.peak_cpu_mb, 1),
            'avg_gpu_peak_mb': round(float(np.mean(gpu_peaks)), 1),
            'avg_cpu_rss_mb':  round(float(np.mean(cpu_peaks)), 1),
            'final_gpu_peak_mb': gpu_peaks[-1],
            'final_cpu_rss_mb':  cpu_peaks[-1],
        }

# ──────────────────────────────────────────────
# 混淆矩阵绘图 & 保存
