# ★ MODIFY: 单折训练 — 增加混淆矩阵 + 内存记录
# ──────────────────────────────────────────────
def train_single_fold(config, device, train_loader, val_loader, class_names,
                      save_dir, fold_tag=''):
    os.makedirs(save_dir, exist_ok=True)
    model = build_soilnet_hybrid(num_classes=config['num_classes']).to(device)
    mixup_cutmix = MixupCutmix(config['mixup_alpha'], config['cutmix_alpha'])
    criterion = nn.CrossEntropyLoss()
    optimizer = optim.AdamW(model.parameters(), lr=config['lr'], weight_decay=config['weight_decay'])
    scaler = GradScaler()
    scheduler = optim.lr_scheduler.CosineAnnealingLR(optimizer, T_max=config['epochs'])
    time_tracker = TimeTracker()
    mem_tracker = MemoryTracker(device)  # ★ ADD

    # CSV 含 per-class + memory 列
    csv_path = os.path.join(save_dir, 'training_metrics.csv')
    csv_hdr = ['epoch','train_loss','val_loss','train_acc','val_acc',
               'train_f1','val_f1','val_precision','val_recall','lr',
               'gpu_peak_mb','cpu_rss_mb']  # ★ ADD memory 列
    for c in class_names:
        csv_hdr += [f'{c}_prec', f'{c}_rec', f'{c}_f1']

    history = {k: [] for k in csv_hdr}
    with open(csv_path, 'w', newline='') as f:
        csv.writer(f).writerow(csv_hdr)

    best_val_acc, best_pcm, best_cm = 0.0, None, None  # ★ ADD best_cm

    for epoch in range(1, config['epochs'] + 1):
        time_tracker.start_epoch()
        mem_tracker.reset_epoch()  # ★ ADD: 重置 GPU 峰值计数器

        tm = train_one_epoch(model, train_loader, optimizer, criterion, scaler,
                             device, mixup_cutmix, config['mix_prob'], time_tracker)
        vm = validate(model, val_loader, criterion, device, class_names)
        scheduler.step(); lr_now = optimizer.param_groups[0]['lr']

        gpu_mb, cpu_mb = mem_tracker.record_epoch()  # ★ ADD: 记录本 epoch 内存
        epoch_time = time_tracker.end_epoch()

        # 写 CSV（含 per-class + memory）
        row = [epoch, tm['train_loss'], vm['val_loss'], tm['train_acc'], vm['val_acc'],
               tm['train_f1'], vm['val_f1'], vm['val_precision'], vm['val_recall'], lr_now,
               gpu_mb, cpu_mb]  # ★ ADD
        for c in class_names:
            pm = vm['per_class_metrics'].get(c, {})
            row += [pm.get('precision',''), pm.get('recall',''), pm.get('f1_score','')]
        with open(csv_path, 'a', newline='') as f:
            csv.writer(f).writerow(row)

        print(f"{fold_tag}Epoch {epoch}/{config['epochs']} ({epoch_time:.1f}s)  "
              f"TrL {tm['train_loss']:.4f} VaL {vm['val_loss']:.4f}  "
              f"TrA {tm['train_acc']:.4f} VaA {vm['val_acc']:.4f}  "
              f"VaF1 {vm['val_f1']:.4f}  LR {lr_now:.2e}  "
              f"GPU {gpu_mb:.0f}MB CPU {cpu_mb:.0f}MB")  # ★ ADD

        if vm['val_acc'] > best_val_acc:
            best_val_acc = vm['val_acc']
            best_pcm = vm['per_class_metrics']
            best_cm = vm['confusion_matrix']  # ★ ADD
            torch.save(model.state_dict(),
                       os.path.join(save_dir, f'best_model_{best_val_acc:.4f}.pth'))
            with open(os.path.join(save_dir, 'best_per_class.json'), 'w') as f:
                json.dump(best_pcm, f, indent=4)
            # ★ ADD: 保存最佳 epoch 的混淆矩阵
            save_confusion_matrix(best_cm, class_names, os.path.join(save_dir, 'best_confusion_matrix.png'))

    # ★ ADD: 训练结束后用最佳模型重新验证，保存最终混淆矩阵
    model.load_state_dict(torch.load(
        os.path.join(save_dir, f'best_model_{best_val_acc:.4f}.pth'),
        map_location=device))
    final_vm = validate(model, val_loader, criterion, device, class_names)
    save_confusion_matrix(final_vm['confusion_matrix'], class_names,
                          os.path.join(save_dir, 'final_confusion_matrix.png'))

    time_stats = time_tracker.get_stats()
    mem_stats = mem_tracker.get_stats()  # ★ ADD
    tp = measure_throughput(model, device, batch_size=config['batch_size'])

    # ★ ADD: 保存内存统计
    with open(os.path.join(save_dir, 'memory_stats.json'), 'w') as f:
        json.dump(mem_stats, f, indent=4)
    with open(os.path.join(save_dir, 'throughput.json'), 'w') as f:
        json.dump(tp, f, indent=4)
    print(f"{fold_tag}Throughput: {tp}")
    print(f"{fold_tag}Memory: Peak GPU {mem_stats.get('peak_gpu_mb',0):.0f}MB, "
          f"Peak CPU {mem_stats.get('peak_cpu_mb',0):.0f}MB")  # ★ ADD

    return best_val_acc, best_pcm, time_stats, tp, mem_stats  # ★ ADD mem_stats

