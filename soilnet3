# ★ MODIFY: 5 折交叉验证 — 增加混淆矩阵 + 内存
# ──────────────────────────────────────────────
def run_cross_validation(config, device):
    print(f"\n{'#'*70}\n  5-Fold Stratified CV — {config['num_classes']} classes\n{'#'*70}")

    train_tf = transforms.Compose([
        transforms.RandomResizedCrop(224),
        transforms.RandomHorizontalFlip(), transforms.RandomVerticalFlip(),
        transforms.ColorJitter(brightness=0.2, contrast=0.2, saturation=0.2, hue=0.1),
        transforms.ToTensor(),
        transforms.Normalize([0.485,0.456,0.406],[0.229,0.224,0.225]),
        RandomErasing(p=config['erase_prob']),
    ])
    val_tf = transforms.Compose([
        transforms.Resize(256), transforms.CenterCrop(224), transforms.ToTensor(),
        transforms.Normalize([0.485,0.456,0.406],[0.229,0.224,0.225]),
    ])

    train_path = os.path.join(config['data_path'], 'train')
    val_path   = os.path.join(config['data_path'], 'val')
    class_names = datasets.ImageFolder(train_path).classes

    ds_tr_aug   = datasets.ImageFolder(train_path, transform=train_tf)
    ds_tr_plain = datasets.ImageFolder(train_path, transform=val_tf)
    has_val = os.path.exists(val_path) and len(os.listdir(val_path)) > 0
    if has_val:
        ds_va_aug   = datasets.ImageFolder(val_path, transform=train_tf)
        ds_va_plain = datasets.ImageFolder(val_path, transform=val_tf)
        combined_aug   = ConcatDataset([ds_tr_aug, ds_va_aug])
        combined_plain = ConcatDataset([ds_tr_plain, ds_va_plain])
        all_targets = ([y for _,y in ds_tr_aug.samples] +
                       [y for _,y in ds_va_aug.samples])
    else:
        combined_aug, combined_plain = ds_tr_aug, ds_tr_plain
        all_targets = [y for _,y in ds_tr_aug.samples]

    skf = StratifiedKFold(n_splits=5, shuffle=True, random_state=config['seed'])
    indices = np.arange(len(all_targets))
    cv_dir = f"cv_results_{time.strftime('%Y%m%d_%H%M%S')}"
    fold_accs, fold_tps, fold_mems = [], [], []  # ★ ADD fold_mems
    fold_cms = []  # ★ ADD: 收集每折最终混淆矩阵

    for fold, (tr_idx, va_idx) in enumerate(skf.split(indices, np.array(all_targets))):
        print(f"\n{'='*60}\n  Fold {fold+1}/5  train={len(tr_idx)} val={len(va_idx)}\n{'='*60}")
        set_seed(config['seed'] + fold)

        train_sub = Subset(combined_aug,   tr_idx.tolist())
        val_sub   = Subset(combined_plain, va_idx.tolist())
        tl = DataLoader(train_sub, batch_size=config['batch_size'], shuffle=True,  num_workers=4, pin_memory=True)
        vl = DataLoader(val_sub,   batch_size=config['batch_size'], shuffle=False, num_workers=4, pin_memory=True)

        fold_dir = os.path.join(cv_dir, f'fold_{fold+1}')
        best_acc, best_pcm, ts, tp, mem = train_single_fold(  # ★ ADD mem
            config, device, tl, vl, class_names, fold_dir,
            fold_tag=f'[F{fold+1}] ')
        fold_accs.append(best_acc); fold_tps.append(tp)
        fold_mems.append(mem)  # ★ ADD

        # ★ ADD: 读取该折最终混淆矩阵
        cm_json = os.path.join(fold_dir, 'final_confusion_matrix.json')
        if os.path.exists(cm_json):
            with open(cm_json) as f:
                fold_cms.append(json.load(f)['matrix'])

    # ★ ADD: 汇总混淆矩阵（取平均）
    avg_cm = None
    if fold_cms:
        avg_cm = np.mean([np.array(c) for c in fold_cms], axis=0).astype(int).tolist()

    # CV 汇总
    summary = {
        'fold_accs': fold_accs,
        'mean_acc': float(np.mean(fold_accs)),
        'std_acc':  float(np.std(fold_accs)),
        'avg_throughput': np.mean([t['throughput(img/s)'] for t in fold_tps]),
        'avg_latency_ms': np.mean([t['latency_ms'] for t in fold_tps]),
        'avg_peak_gpu_mb': round(np.mean([m['peak_gpu_mb'] for m in fold_mems]), 1),  # ★ ADD
        'avg_peak_cpu_mb': round(np.mean([m['peak_cpu_mb'] for m in fold_mems]), 1),  # ★ ADD
    }
    os.makedirs(os.path.join(cv_dir, 'summary'), exist_ok=True)
    with open(os.path.join(cv_dir, 'summary', 'cv_summary.json'), 'w') as f:
        json.dump(summary, f, indent=4)

    # ★ ADD: 保存平均混淆矩阵
    if avg_cm:
        save_confusion_matrix(np.array(avg_cm), class_names,
                              os.path.join(cv_dir, 'summary', 'cv_avg_confusion_matrix.png'))
        with open(os.path.join(cv_dir, 'summary', 'cv_avg_confusion_matrix.json'), 'w') as f:
            json.dump({'matrix': avg_cm, 'class_names': class_names,
                       'note': 'Averaged across 5 folds (rounded to int)'}, f, indent=4)

    print(f"\n{'#'*70}\n  CV Result: {summary['mean_acc']:.4f} ± {summary['std_acc']:.4f}")
    for i, a in enumerate(fold_accs):
        print(f"  Fold {i+1}: {a:.4f}  |  Throughput: {fold_tps[i]}  |  "
              f"Peak GPU: {fold_mems[i]['peak_gpu_mb']:.0f}MB  "
              f"Peak CPU: {fold_mems[i]['peak_cpu_mb']:.0f}MB")  # ★ ADD
    print(f"  Avg Throughput: {summary['avg_throughput']:.1f} img/s  "
          f"Avg Latency: {summary['avg_latency_ms']:.2f} ms")
    print(f"  Avg Peak GPU: {summary['avg_peak_gpu_mb']:.0f}MB  "
          f"Avg Peak CPU: {summary['avg_peak_cpu_mb']:.0f}MB")  # ★ ADD
    print(f"{'#'*70}")
    return summary

