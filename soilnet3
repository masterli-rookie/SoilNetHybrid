    }

    set_seed(config['seed'])
    device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
    print(f"Device: {device}")

    if config['use_cv']:
        return run_cross_validation(config, device)

    # 仅保留基本数据增强：随机裁剪、水平/垂直翻转、归一化
    train_transform = transforms.Compose([
        transforms.RandomResizedCrop(224),
        transforms.RandomHorizontalFlip(),
        transforms.RandomVerticalFlip(),
        transforms.ToTensor(),
        transforms.Normalize([0.485,0.456,0.406],[0.229,0.224,0.225]),
    ])
    val_transform = transforms.Compose([
        transforms.Resize(256), transforms.CenterCrop(224), transforms.ToTensor(),
        transforms.Normalize([0.485,0.456,0.406],[0.229,0.224,0.225]),
    ])

    train_dataset = datasets.ImageFolder(os.path.join(config['data_path'],'train'), train_transform)
    val_dataset   = datasets.ImageFolder(os.path.join(config['data_path'],'val'),   val_transform)
    class_names   = train_dataset.classes

    train_loader = DataLoader(train_dataset, batch_size=config['batch_size'],
                              shuffle=True, num_workers=4, pin_memory=True)
    val_loader   = DataLoader(val_dataset,   batch_size=config['batch_size'],
                              shuffle=False, num_workers=4, pin_memory=True)

    best_val_acc, best_pcm, time_stats, tp, mem_stats = train_single_fold(
        config, device, train_loader, val_loader, class_names, config['save_dir'])

    summary = {
        'best_val_acc': float(best_val_acc),
        'best_per_class': best_pcm,
        'time_stats': time_stats,
        'throughput': tp,
        'memory': mem_stats,
    }
    with open(os.path.join(config['save_dir'], 'final_summary.json'), 'w') as f:
        json.dump(summary, f, indent=4, default=str)

    print(f"\nTraining done! Best Acc: {best_val_acc:.4f}")
    print(f"Throughput: {tp}")
    print(f"Memory: Peak GPU {mem_stats['peak_gpu_mb']:.0f}MB, "
          f"Peak CPU {mem_stats['peak_cpu_mb']:.0f}MB")
    if best_pcm:
        print("\nPer-Class (best epoch):")
        for name, m in best_pcm.items():
            print(f"  {name:<20} P {m['precision']:.4f}  R {m['recall']:.4f}  "
                  f"F1 {m['f1_score']:.4f}  N {m['support']}")

if __name__ == "__main__":
    main()
